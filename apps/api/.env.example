PORT=3333

# Caminho do executavel do ODA File Converter, usado para converter DWG -> DXF.
# Download oficial (gratuito): https://www.opendesign.com/guestfiles/oda_file_converter
# Exemplo Windows: C:\Program Files\ODA\ODAFileConverter 26.4.0\ODAFileConverter.exe
# Opcional quando o ODA foi instalado em uma pasta padrao do Windows: a API
# tenta localizar o executavel automaticamente. Se usar outra pasta, informe
# o caminho completo abaixo.
ODA_CONVERTER_PATH=

# Versao do DXF gerado pelo ODA (padrao: ACAD2018).
ODA_OUTPUT_VERSION=ACAD2018
