{
  "name": "gerador-croqui",
  "private": true,
  "version": "0.0.1",
  "description": "Gerador de croqui de projetos de automacao/AV/rede a partir de plantas DWG/PDF",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
